{
  "name": "cube-level-generator",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop authoring tool for Rubik's cube levels — chapters, formulas, 3D preview, and LLM-assisted formula generation",
  "author": "飞马客, fmk",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron:dev": "vite",
    "build": "tsc -b && vite build && electron-builder",
    "build:web": "tsc -b && vite build",
    "build:win": "tsc -b && vite build && electron-builder --win",
    "build:mac": "tsc -b && vite build && electron-builder --mac",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "mysql2": "^3.23.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-joyride": "^3.2.0",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.libercube.cube-level-generator",
    "productName": "cube-level-generator",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/mysql2/**/*",
      "node_modules/sqlstring/**/*",
      "node_modules/denque/**/*",
      "node_modules/generate-function/**/*",
      "node_modules/is-property/**/*",
      "node_modules/long/**/*",
      "node_modules/lru.min/**/*",
      "node_modules/named-placeholders/**/*",
      "node_modules/aws-ssl-profiles/**/*",
      "node_modules/iconv-lite/**/*",
      "node_modules/safer-buffer/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/mysql2/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
